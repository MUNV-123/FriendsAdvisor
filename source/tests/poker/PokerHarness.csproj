<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <DefineConstants Condition="'$(GameOraclePath)' != ''">$(DefineConstants);GAME_SOURCE_ORACLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PokerHarness.cs"/>
    <Compile Include="../../PokerPredictions.cs" Link="PokerPredictions.cs"/>
    <Compile Include="$(GameOraclePath)" Condition="'$(GameOraclePath)' != ''" Link="ReferenceEvaluator.cs"/>
  </ItemGroup>
</Project>
